{
  "name": "tintalata-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tintalata — Aplikasyon sa Pag-edit ng Dokumento at Pagguhit (Filipino / Tagalog)",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --no-warnings --watch server/index.mjs",
    "dev:client": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "start": "node --no-warnings server/index.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
